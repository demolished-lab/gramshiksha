# Copy to .env and fill in (never commit real secrets).
# Local dev default is SQLite; production uses Postgres (Neon/Supabase) + ssl.
DATABASE_URL=sqlite:///./gramshiksha.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
JWT_SECRET=change-me-to-64-random-chars
# JSON list — must stay valid JSON:
CORS_ORIGINS=["http://localhost:5174", "http://127.0.0.1:5174"]
# Upload storage (optional): leave empty for local disk. Set all three for
# Cloudinary free tier (needed on Render/ephemeral disks + multi-instance).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=gramshiksha
# Error tracking (optional, Sentry free tier). Empty = disabled.
# SENTRY_DSN=
# SENTRY_ENV=production

# --- Password reset delivery (plain SMTP — any provider) -------------------
# Unset in dev: SQLite logs the 6-digit code to the server log instead.
# Required in production: without SMTP_HOST the API answers 503 on
# /auth/reset-request (it never silently swallows a reset request).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@gramshiksha.in
# SMTP_USE_TLS=true   # STARTTLS (587); set false for implicit-TLS port 465

# --- Deploy safety gates (see app/main.py: check_production_safety) -------
# Demo accounts (admin@gramshiksha.in / Admin@1234) seed only on SQLite by
# default. SEED_DEMO=true forces them on (never do this on a real instance);
# SEED_DEMO=false forces them off.
# SEED_DEMO=auto
# Production refuses to boot without Cloudinary uploads. Set this ONLY if you
# mounted a persistent disk at backend/uploads.
# ALLOW_EPHEMERAL_UPLOADS=false

# --- API reference (/docs + /openapi.json) ---------------------------------
# Unset = auto: on in dev, off in production (it maps the attack surface).
# ENABLE_DOCS=true|false
