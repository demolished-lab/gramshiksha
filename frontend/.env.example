# Production API base. Leave empty for same-origin (Netlify/Vercel rewrites /api/*).
# Example: VITE_API_URL=https://gramshiksha-backend.onrender.com
VITE_API_URL=
# Optional: Google Drive import in Study Studio. All three values are public;
# never put a client secret in a Vite env. The OAuth client's authorized JS
# origin must be the site, and the API key must allow the site plus
# https://docs.google.com/* (the Picker iframe origin).
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# VITE_GOOGLE_PICKER_KEY=AIza...
# VITE_GOOGLE_APP_ID=1234567890

# Optional donation fallback. Prefer DONATE_UPI in the Render backend; use
# this only when the backend env cannot be changed. The UPI id is public by
# design. Never put a PIN, card number or bank password in any env value.
# VITE_DONATE_UPI=name@upi
